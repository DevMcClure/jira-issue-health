# Dependencies
node_modules/

# Build output
dist/
dist-server/
*.tsbuildinfo
.vite/

# Test / coverage
coverage/

# Logs
*.log

# --- Secrets: never commit any ------------------------------------------
# Env files (only the placeholder template is committed)
.env
.env.*
!.env.example
# Keys, certificates and keystores
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.der
*.jks
*.keystore
id_rsa*
id_ed25519*
id_ecdsa*
# Credential and token files
secrets/
*.secret
*.secrets
credentials*.json
*credentials*
service-account*.json
*.token
.npmrc
.netrc
.htpasswd

# Real Jira exports: keep real company data out of the repo.
# Only the generated mock export is committed.
exports/
*.real.json

# --- Docs stay local ----------------------------------------------------
# The only committed doc is the root README.
docs/
*.md
!/README.md

# Editors / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store

# Claude Code local settings
.claude/settings.local.json
