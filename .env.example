# Copy to .env (git-ignored) and fill in what you need. Never commit a real .env.
# The web app runs without one; the server needs at least TOKEN_ENCRYPTION_KEY.

# ---------------------------------------------------------------- Web app (Vite)

# Where the "Jira Dashboard" link in the product switcher points.
VITE_DASHBOARD_URL=https://example.github.io/jira-dashboard/

# Sub-path the app is served from. "/" locally; CI sets /<repo-name>/ for GitHub Pages.
VITE_BASE_PATH=/

# "demo" (default): everything in the browser with a mock Jira (what GitHub Pages runs).
# "api": talk to the Jira Health server. `pnpm dev:live` sets this for you.
VITE_DATA_MODE=demo

# The server's API root in api mode. "/api" uses Vite's dev proxy (API_PROXY_TARGET) or the same origin.
VITE_API_BASE_URL=/api
API_PROXY_TARGET=http://127.0.0.1:8787

# ---------------------------------------------------------------- Server (pnpm dev:server)

HOST=127.0.0.1
PORT=8787
# Origins allowed to call the API with cookies, comma-separated (never *).
CORS_ORIGIN=http://localhost:5173

# Live issue data. Point these at the MongoDB the issue feed writes to.
DATA_STORE=mongo
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB_NAME=jira_health
# MONGO_TLS_CA_FILE=/path/to/ca.pem
# Put the mock data into an empty database (development only).
SEED_MOCK=false
# Without change streams (a standalone MongoDB), how often to look for changes.
LIVE_POLL_SECONDS=15
# "open": anyone who can reach the server can read the data. "connected": only people connected to Jira.
DATA_ACCESS=open
# Bearer token for POST /api/ingest (a Trawler export); leave unset to turn ingest off.
# INGEST_TOKEN=

# Jira. "mock" is a built-in stand-in; "rest" writes to a real Jira as each person.
JIRA_MODE=mock
# JIRA_BASE_URL=https://jira.example.com
# "datacenter" (personal access tokens) or "cloud" (email + API token).
JIRA_FLAVOUR=datacenter
# Field ids from your Jira (Admin → Issues → Custom fields, or GET /rest/api/2/field).
# JIRA_FIELD_STORY_POINTS=customfield_10016
# JIRA_FIELD_EPIC_LINK=customfield_10014
JIRA_RESOLUTIONS=Done,Won't Do,Duplicate,Cannot Reproduce
JIRA_TIMEOUT_SECONDS=15

# Encrypts each person's Jira token at rest. 32+ random characters, e.g. `openssl rand -base64 48`.
TOKEN_ENCRYPTION_KEY=change-me-to-a-long-random-string-of-32-chars-or-more
SESSION_TTL_HOURS=12
# Web app on another site than the API (e.g. GitHub Pages → your server): COOKIE_SAMESITE=none (HTTPS only).
COOKIE_SAMESITE=lax
COOKIE_SECURE=true
LOG_LEVEL=info
